BCS_URL=https://bcs.medienwerft.de
BCS_USERNAME=
BCS_PASSWORD=
BCS_USER_OID=
# Base32 TOTP secret from your BCS authenticator setup. Required only if 2FA
# is enabled on the account; leave empty otherwise.
BCS_TOTP_SECRET=
PORT=
# SSO/OIDC login: instead of USERNAME/PASSWORD, log in to BCS in your browser
# and copy the JSESSIONID and CSRF_Token cookies here (devtools > Cookies).
# When set, USERNAME/PASSWORD/TOTP are ignored. Re-copy when the session expires.
BCS_SESSION_ID=
BCS_CSRF_TOKEN=
# Booking view: "week" books via Wochenbuchen (works with any day layout);
# default (empty) uses the day view, which needs the task tree block visible.
BCS_BOOKING_VIEW=
